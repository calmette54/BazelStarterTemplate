load("@bazel_gazelle//:def.bzl", "gazelle", "gazelle_binary")

# We don't actually need an external repo to define Starlark settings. But
# Skylib provides convenience macros that reduce boilerplate, so we'll use that
# here.
#
# See https://bazel.build/extending/config and
# https://github.com/bazelbuild/bazel-skylib) for more info.
load("@bazel_skylib//rules:common_settings.bzl", "int_flag", "string_flag")
load("@hedron_compile_commands//:refresh_compile_commands.bzl", "refresh_compile_commands")
load("//:bzl/defs.bzl", "revision_mode")

revision_mode(
    name = "revision_mode",
    build_setting_default = "DIRTY",
)

# The semantic version used to tag the tarball when versioning_mode="Release"
string_flag(
    name = "release_version",
    build_setting_default = "",
)

# The commit-sha used to tag the tarball when versioning_mode="wip"
string_flag(
    name = "commit_sha",
    build_setting_default = "",
)

config_setting(
    name = "is_release",
    flag_values = {
        ":revision_mode": "RELEASE",
    },
)

config_setting(
    name = "is_wip",
    flag_values = {
        ":revision_mode": "WIP",
    },
)

alias(
    name = "format",
    actual = "//bzl/format",
)

refresh_compile_commands(
    name = "refresh_all",
    targets = ["//..."],
)

# Gazelle target for automatic BUILD file generation
# This uses the Python Gazelle plugin to automatically generate and update
# py_library, py_binary, and py_test targets based on Python source code
# Run with: bazel run //:gazelle
gazelle(
    name = "gazelle",
    gazelle = "@rules_python_gazelle_plugin//python:gazelle_binary",
    data = [
        "//python:gazelle_python.yaml",
        "//python:requirements_lock.txt",
    ],
)

# Update Gazelle Python manifest when dependencies change
# This updates the import-to-package mapping that Gazelle uses
# Run with: bazel run //:gazelle_python_manifest.update
gazelle(
    name = "gazelle_python_manifest.update",
    extra_args = [
        "-from_file=python/gazelle_python.yaml",
        "-to_macro=python/gazelle_python_manifest.update",
    ],
    gazelle = "@rules_python_gazelle_plugin//python:gazelle_binary",
    data = ["@rules_python_gazelle_plugin//python:std_modules"],
)
