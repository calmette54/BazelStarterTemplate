module(
    name = "cpp-starter-template",
    version = "3.0.0",
)

#------------- Application dependencies -------------
# Use compatible BCR versions and provide correct SONAMEs for Drake
bazel_dep(name = "fmt", version = "10.1.1")  # Required by spdlog 1.12.0
bazel_dep(name = "spdlog", version = "1.12.0")
bazel_dep(name = "protobuf", version = "31.0-rc2", repo_name = "com_google_protobuf")
bazel_dep(name = "bazel_features", version = "1.29.0", repo_name = "proto_bazel_features")

version = use_extension("@proto_bazel_features//private:extensions.bzl", "version_extension")
use_repo(version, "bazel_features_globals", "bazel_features_version")

#------------- Testing dependencies -----------------
bazel_dep(name = "googletest", version = "1.15.2")
bazel_dep(name = "google_benchmark", version = "1.9.2")
bazel_dep(name = "doctest", version = "2.4.11")

#------------- Documentation dependencies -----------
# Starlark implementation of Doxygen rules in Bazel to automatically document the codebase
# https://github.com/TendTo/rules_doxygen
bazel_dep(name = "rules_doxygen", version = "2.1.0", dev_dependency = True)

doxygen_extension = use_extension("@rules_doxygen//:extensions.bzl", "doxygen_extension")

# Use the local doxygen installation on x86
doxygen_extension.configuration(
    platform = "linux",
    sha256 = "dcfc9aa4cc05aef1f0407817612ad9e9201d9bf2ce67cecf95a024bba7d39747",
    version = "1.10.0",
)
use_repo(doxygen_extension, "doxygen")

#################################################################################
# Utilities
#################################################################################
# https://github.com/bazelbuild/bazel-skylib
bazel_dep(name = "bazel_skylib", version = "1.7.1")

# Formatting and Linting
# https://github.com/aspect-build/rules_lint
bazel_dep(name = "aspect_rules_lint", version = "1.2.2")

# Hedron's Compile Commands Extractor for Bazel
# https://github.com/hedronvision/bazel-compile-commands-extractor
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    commit = "6d29d97b4a40143104cce158b0da848db72cb769",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
)

###############################################################################
# Bazel Dependencies # https://registry.bazel.build/
###############################################################################
# https://github.com/bazelbuild/rules_cc
bazel_dep(name = "rules_cc", version = "0.1.1")

# https://github.com/bazelbuild/platforms/release
bazel_dep(name = "platforms", version = "0.0.11")

# https://github.com/bazel-contrib/toolchains_llvm
bazel_dep(name = "toolchains_llvm", version = "1.4.0", dev_dependency = True)

# https://github.com/bazelbuild/bazel/blob/master/tools/build_defs/repo/http.bzl
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

#--------------------- LLVM Toolchain --------------
# https://steven.casagrande.io/posts/2024/sysroot-generation-toolchains-llvm/
# https://github.com/bazelbuild/rules_rust/blob/main/examples/cross_compile/MODULE.bazel

SYSROOT_BUILD_CONTENT = """
filegroup(
    name = "sysroot",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
"""

# INTEL/AMD64 Sysroot. LastModified: 2024-04-26T19:15
# https://commondatastorage.googleapis.com/chrome-linux-sysroot/
http_archive(
    name = "sysroot_linux_x64",
    build_file_content = SYSROOT_BUILD_CONTENT,
    sha256 = "5df5be9357b425cdd70d92d4697d07e7d55d7a923f037c22dc80a78e85842d2c",
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/toolchain/4f611ec025be98214164d4bf9fbe8843f58533f7/debian_bullseye_amd64_sysroot.tar.xz"],
)

# ARM 64 Sysroot. LastModified: 2024-04-26T18:33
# https://commondatastorage.googleapis.com/chrome-linux-sysroot/
http_archive(
    name = "sysroot_linux_aarch64",
    build_file_content = SYSROOT_BUILD_CONTENT,
    sha256 = "d303cf3faf7804c9dd24c9b6b167d0345d41d7fe4bfb7d34add3ab342f6a236c",
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/toolchain/906cc7c6bf47d4bd969a3221fc0602c6b3153caa/debian_bullseye_arm64_sysroot.tar.xz"],
)

# Configure and register the toolchain.
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm", dev_dependency = True)
llvm.toolchain(
    name = "llvm_toolchain",
    cxx_standard = {
        "19.1.6": "c++23",
    },
    llvm_versions = {
        "linux-x86_64": "19.1.6",
        "linux-aarch64": "19.1.6",
    },
    sha256 = {
        "linux-x86_64": "d55dcbb309de7ade4e3073ec3ac3fac4d3ff236d54df3c4de04464fe68bec531",
        "linux-aarch64": "d55dcbb309de7ade4e3073ec3ac3fac4d3ff236d54df3c4de04464fe68bec531",
    },
    stdlib = {
        "linux-x86_64": "stdc++",
        "linux-aarch64": "stdc++",
    },
    strip_prefix = {
        "linux-x86_64": "LLVM-19.1.6-Linux-X64",
        "linux-aarch64": "clang+llvm-19.1.6-aarch64-linux-gnu",
    },
    urls = {
        "linux-x86_64": [
            "https://github.com/llvm/llvm-project/releases/download/llvmorg-19.1.6/LLVM-19.1.6-Linux-X64.tar.xz",
        ],
        "linux-aarch64": [
            "https://github.com/llvm/llvm-project/releases/download/llvmorg-19.1.6/clang+llvm-19.1.6-aarch64-linux-gnu.tar.xz",
        ],
    },
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@sysroot_linux_x64//:sysroot",
    targets = ["linux-x86_64"],
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@sysroot_linux_aarch64//:sysroot",
    targets = ["linux-aarch64"],
)
use_repo(llvm, "llvm_toolchain")

register_toolchains(
    "@llvm_toolchain//:all",
    dev_dependency = True,
)

#--------------------- Python Toolchain --------------
# https://rules-python.readthedocs.io/en/latest/toolchains.html
bazel_dep(name = "rules_python", version = "1.4.1", dev_dependency = True)

#--------------------- Go Toolchain for Gazelle --------------
# Add rules_go dependency for Go toolchain support
bazel_dep(name = "rules_go", version = "0.53.0")

# Gazelle for automatic BUILD file generation
# https://github.com/bazelbuild/bazel-gazelle
bazel_dep(name = "gazelle", version = "0.42.0", repo_name = "bazel_gazelle")

# Python Gazelle plugin for automatic Python BUILD file generation
# https://github.com/bazel-contrib/rules_python/tree/main/gazelle
bazel_dep(name = "rules_python_gazelle_plugin", version = "0.26.0")

# Configure Go SDK for Gazelle (requires Go 1.23.0+ for Gazelle 0.42.0)
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.23.1")
use_repo(go_sdk, "go_default_sdk")

python = use_extension(
    "@rules_python//python/extensions:python.bzl",
    "python",
    dev_dependency = True,
)
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "testcontainers_deps",
    python_version = "3.12",
    requirements_lock = "//integration:requirements_lock_3_12.txt",
)

# Main Python AI dependencies (PydanticAI, PyTorch, etc.)
pip.parse(
    hub_name = "python_ai_deps",
    python_version = "3.12",
    requirements_lock = "//python:requirements_lock.txt",
)
use_repo(pip, "testcontainers_deps", "python_ai_deps")

###############################################################################
# Containarize your application
#
# TIP: For testing, https://registry.bazel.build/modules/container_structure_test
###############################################################################
bazel_dep(name = "rules_oci", version = "2.2.6")
bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "aspect_bazel_lib", version = "2.15.3")
bazel_dep(name = "tweag-credential-helper", version = "0.0.5")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")

# Pull needed base image
oci.pull(
    name = "docker_lib_ubuntu",
    digest = "sha256:67211c14fa74f070d27cc59d69a7fa9aeff8e28ea118ef3babc295a0428a6d21",
    image = "ubuntu",
    platforms = [
        "linux/arm64/v8",
        "linux/amd64",
    ],
)

# Expose the base image
use_repo(oci, "docker_lib_ubuntu", "docker_lib_ubuntu_linux_amd64", "docker_lib_ubuntu_linux_arm64_v8")

###############################################################################
# Open3D Example with System Dependencies
###############################################################################

# Eigen dependency for Open3D and Drake - using older compatible version
bazel_dep(name = "eigen", version = "3.4.0.bcr.3")

# Open3D prebuilt binary
http_archive(
    name = "open3d",
    build_file = "//example_open3d:open3d.BUILD",
    strip_prefix = "open3d-devel-linux-x86_64-cxx11-abi-0.19.0",
    urls = ["https://github.com/isl-org/Open3D/releases/download/v0.19.0/open3d-devel-linux-x86_64-cxx11-abi-0.19.0.tar.xz"],
    integrity = "sha256-LlJf0q/n6AkH0rbjxmtp4u8UgdvO7Vcnt0mm5ly6VyA="
)

###############################################################################
# Drake Example with System Dependencies
###############################################################################

# Drake prebuilt binary
http_archive(
    name = "drake",
    build_file = "//example_drake:drake.BUILD",
    strip_prefix = "drake",
    urls = ["https://github.com/RobotLocomotion/drake/releases/download/v1.44.0/drake-1.44.0-noble.tar.gz"],
)

###############################################################################
# Nixpkgs Dependencies - Pure bzlmod approach
###############################################################################

# Add rules_nixpkgs_core dependency
bazel_dep(name = "rules_nixpkgs_core", version = "0.13.0")

# Configure nixpkgs repository using nix_repo extension
nix_repo = use_extension("@rules_nixpkgs_core//extensions:repository.bzl", "nix_repo")
nix_repo.github(
    name = "nixpkgs",
    commit = "25.05",  # Use commit/branch instead of tag
    org = "NixOS",
    repo = "nixpkgs",
    sha256 = "",  # Let Bazel compute the hash
)
use_repo(nix_repo, "nixpkgs")

# Configure nixpkgs packages using nix_pkg extension
nix_pkg = use_extension("@rules_nixpkgs_core//extensions:package.bzl", "nix_pkg")

# Simple hello package
nix_pkg.attr(
    name = "hello",
    attr = "hello",
)

# Core Open3D Dependencies - Raw Package Imports Only
# OpenGL libraries
nix_pkg.attr(
    name = "libgl",
    attr = "libGL",
)
nix_pkg.attr(
    name = "libglu",
    attr = "libGLU",
)
nix_pkg.attr(
    name = "libglu_dev",
    attr = "libGLU.dev",
    build_file_content = """
exports_files(glob(["include/**/*.h"]), visibility = ["//visibility:public"])
""",
)
nix_pkg.attr(
    name = "libglvnd_dev",
    attr = "libglvnd.dev", 
    build_file_content = """
exports_files(glob(["include/**/*.h"]), visibility = ["//visibility:public"])
""",
)
nix_pkg.attr(
    name = "libegl",
    attr = "libglvnd",
)

# Core system libraries
nix_pkg.attr(
    name = "tbb",
    attr = "tbb_2022_0",
)
nix_pkg.attr(
    name = "libcxx",
    attr = "llvmPackages.libcxx",
)

# Windowing libraries  
nix_pkg.attr(
    name = "glfw",
    attr = "glfw",
)
nix_pkg.attr(
    name = "libx11",
    attr = "xorg.libX11",
)

# Note: All Drake dependencies removed - Open3D only needs core packages above

# Make Open3D packages available in this workspace
use_repo(
    nix_pkg,
    # Core Open3D dependencies - raw packages only
    "libgl",           # OpenGL library
    "libglu",          # GLU runtime library
    "libglu_dev",      # GLU headers
    "libglvnd_dev",    # OpenGL headers
    "libegl",          # EGL context
    "tbb",             # Threading
    "libcxx",          # C++ runtime
    "glfw",            # Windowing
    "libx11",          # X11 windowing
    # Keep hello for testing
    "hello",
)
