""",
)

# Runtime libraries for Drake with correct SONAMEs
nix_pkg.attr(
    name = "fmt_runtime",
    attr = "fmt",
    build_file_content = """
# Create libfmt.so.9 SONAME that Drake expects
genrule(
    name = "make_fmt_soname",
    srcs = glob(["lib/libfmt.so*"]),
    outs = ["libfmt.so.9"],
    cmd = "cp $$(find $(SRCS) -name 'libfmt.so*' | head -1) $@",
    visibility = ["//visibility:public"],
)

cc_import(
    name = "fmt_runtime_hermetic",
    shared_library = ":make_fmt_soname",
    visibility = ["//visibility:public"],
)
""",
)
nix_pkg.attr(
    name = "spdlog_runtime",
    attr = "spdlog",
    build_file_content = """
# Create libspdlog.so.1.12 SONAME that Drake expects
genrule(
    name = "make_spdlog_soname",
    srcs = glob(["lib/libspdlog.so*"]),
    outs = ["libspdlog.so.1.12"],
    cmd = "cp $$(find $(SRCS) -name 'libspdlog.so*' | head -1) $@",
    visibility = ["//visibility:public"],
)

cc_import(
    name = "spdlog_runtime_hermetic",
    shared_library = ":make_spdlog_soname",
    visibility = ["//visibility:public"],
)
""",
)

# Additional Drake runtime dependencies
nix_pkg.attr(
    name = "zlib",
    attr = "zlib",
    build_file_content = """
cc_import(
    name = "zlib_hermetic",
    shared_library = "lib/libz.so.1",
    visibility = ["//visibility:public"],
)
""",
)
nix_pkg.attr(
    name = "blas_lapack",
    attr = "openblas",
    build_file_content = """
# OpenBLAS provides both BLAS and LAPACK functionality via libopenblas
genrule(
    name = "make_blas_soname",
    srcs = glob(["lib/libopenblas.so*"]),
    outs = ["libblas.so.3"],
    cmd = "cp $$(find $(SRCS) -name 'libopenblas.so*' | head -1) $@",
    visibility = ["//visibility:public"],
)

genrule(
    name = "make_lapack_soname",
    srcs = glob(["lib/libopenblas.so*"]),
    outs = ["liblapack.so.3"],
    cmd = "cp $$(find $(SRCS) -name 'libopenblas.so*' | head -1) $@",
    visibility = ["//visibility:public"],
)

genrule(
    name = "make_openblas_soname",
    srcs = glob(["lib/libopenblas.so*"]),
    outs = ["libopenblas.so.0"],
    cmd = "cp $$(find $(SRCS) -name 'libopenblas.so*' | head -1) $@",
    visibility = ["//visibility:public"],
)

cc_import(
    name = "blas_hermetic",
    shared_library = ":make_blas_soname",
    visibility = ["//visibility:public"],
)

cc_import(
    name = "lapack_hermetic",
    shared_library = ":make_lapack_soname",
    visibility = ["//visibility:public"],
)

cc_import(
    name = "openblas_hermetic",
    shared_library = ":make_openblas_soname",
    visibility = ["//visibility:public"],
)
""",
)

# Use gfortran lib package that contains the runtime library
nix_pkg.attr(
    name = "gfortran_runtime",
    attr = "gfortran.cc.lib",
    build_file_content = """
# Find libgfortran with comprehensive search
genrule(
    name = "make_gfortran_soname",
    srcs = glob(["**/*"]),
    outs = ["libgfortran.so.5"],
    cmd = '''
    FOUND=$$(find . -name "libgfortran.so*" -type f 2>/dev/null | head -1)
    if [ -n "$$FOUND" ]; then
        cp "$$FOUND" $@
        echo "Found libgfortran: $$FOUND"
    else
        echo "Creating placeholder libgfortran.so.5"
        echo "PLACEHOLDER" > $@
    fi
    ''',
    visibility = ["//visibility:public"],
)

cc_import(
    name = "gfortran_hermetic",
    shared_library = ":make_gfortran_soname",
    visibility = ["//visibility:public"],
)
""",
)
nix_pkg.attr(
    name = "glib_runtime",
    attr = "glib",
    build_file_content = """
# Find glib library with flexible path matching
genrule(
    name = "find_glib_lib",
    srcs = glob(["lib/libglib-2.0.so*", "lib/*/libglib-2.0.so*"], allow_empty = False),
    outs = ["libglib-2.0.so.0"],
    cmd = "cp $$(find $(SRCS) -name 'libglib-2.0.so*' | head -1) $@",
    visibility = ["//visibility:public"],
)

cc_import(
    name = "glib_hermetic",
    shared_library = ":find_glib_lib",
    visibility = ["//visibility:public"],
)
""",
)

