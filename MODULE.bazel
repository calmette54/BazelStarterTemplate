nix_repo.github(
    name = "nixpkgs",
    commit = "25.05",  # Use commit/branch instead of tag
    org = "NixOS",
    repo = "nixpkgs",
    sha256 = "",  # Let Bazel compute the hash
)
use_repo(nix_repo, "nixpkgs")

# Configure nixpkgs packages using nix_pkg extension
nix_pkg = use_extension("@rules_nixpkgs_core//extensions:package.bzl", "nix_pkg")

