# Configure credential-helper to download a prebuilt binary
common --@tweag-credential-helper//bzl/config:helper_build_mode="auto"

# rules_oci: disable builtin credential handling
common --repo_env=OCI_GET_TOKEN_ALLOW_FAIL=1

# Configure the credential-helper to be used for your domains
# GitHub
common --credential_helper=github.com=%workspace%/tools/credential-helper
common --credential_helper=raw.githubusercontent.com=%workspace%/tools/credential-helper
# Docker
common --credential_helper=index.docker.io=%workspace%/tools/credential-helper

# Build for aarch64 or x86_64
build:aarch64 --platforms=@toolchains_llvm//platforms:linux-aarch64
build:x86_64 --platforms=@toolchains_llvm//platforms:linux-x86_64

# >>> template:cpp
###############################################################################
# CUDA (rules_cuda, hermetic toolkit from MODULE.bazel)
###############################################################################
common --@rules_cuda//cuda:enable=true
common --@rules_cuda//cuda:compiler=nvcc
# Ampere (RTX 30xx, A40, A6000): the GPUs that tools/remote/server/gpu.env
# rents. Change both together.
common --@rules_cuda//cuda:archs=compute_86:sm_86,compute_86
# <<< template:cpp

###############################################################################
# GPU tests (bzl/gpu.bzl)
#
# Tests that need a GPU are tagged `requires-gpu` and fit in 6 GB; tests that
# need a larger GPU (12-24 GB) are tagged `requires-large-gpu`. Both are
# skipped by default and run one at a time by --config=gpu and
# --config=large-gpu, on this machine's GPU or, with --config=remote, on a
# rented one:
#
#   bazelisk test --config=gpu //...
#   bazelisk test --config=remote --config=gpu //...
###############################################################################
test --test_tag_filters=-requires-gpu,-requires-large-gpu
test:gpu --test_tag_filters=requires-gpu,-requires-large-gpu
test:gpu --local_test_jobs=1
test:gpu --test_env=CUDA_VISIBLE_DEVICES
test:large-gpu --test_tag_filters=requires-large-gpu
test:large-gpu --local_test_jobs=1
test:large-gpu --test_env=CUDA_VISIBLE_DEVICES

###############################################################################
# Remote execution: the NativeLink server of tools/remote/ (see
# tools/remote/README.md), reached through an ssh tunnel to its
# loopback. Every action runs there: the builds and the CPU tests on the
# server, the GPU tests on a vast.ai box the server rents for them
# (bzl/gpu.bzl).
#
#   ssh -fN rbe-server                             # once per session: LocalForward 50051
#   bazelisk test --config=remote //...
#   bazelisk test --config=remote --config=gpu //...
###############################################################################
build:remote --remote_executor=grpc://127.0.0.1:50051
build:remote --extra_execution_platforms=//tools/remote:platform
# The outputs stay in the CAS; only what a command needs comes down.
build:remote --remote_download_minimal
build:remote --remote_cache_compression
# The first build uploads the toolchains over the uplink.
build:remote --remote_timeout=3600
# The same action keys from every client: no client environment, no stamp.
build:remote --incompatible_strict_action_env
build:remote --nostamp
# Actions in flight; the server's worker runs 6 at a time, a GPU box 1.
build:remote --jobs=32
# A test's timeout is its action's, and the pull of the inputs by a fresh GPU
# box counts: short, moderate, long with room for it, eternal at the workers'
# max_action_timeout_s of 7200.
test:remote --test_timeout=900,1200,1800,7200
# What a test produces comes down like a local test's: its log, its test.xml
# and its undeclared outputs (test.outputs/), cached runs included. Without
# it, --remote_download_minimal leaves them in the server's CAS.
test:remote --remote_download_regex=.*/test\.(log|xml)$
test:remote --remote_download_regex=.*/test\.outputs(/.*)?$

# This tells Bazel how to interact with the version control system
build --stamp --workspace_status_command=./tools/workspace_status.sh

# Alias for the build setting
build --flag_alias=revision_mode=//:revision_mode
build --flag_alias=release_version=//:release_version
build --flag_alias=commit_sha=//:commit_sha

###############################################################################
# CI (GitHub Actions, see .github/workflows/ci.yml)
#
# GitHub-hosted runners have Docker (the `requires-docker` tests run) but no
# GPU: the `requires-gpu` and `requires-large-gpu` tests are only built.
###############################################################################
common:ci --color=yes --curses=no
test:ci --test_tag_filters=-requires-gpu,-requires-large-gpu
test:ci --test_output=errors

###############################################################################
# Code coverage
#
#   bazelisk coverage //...
#   genhtml bazel-out/_coverage/_coverage_report.dat -o coverage-html
###############################################################################
# The LLVM toolchain instruments with -fprofile-instr-generate, so use
# LLVM's native coverage instead of gcov.
coverage --experimental_use_llvm_covmap
coverage --experimental_generate_llvm_lcov
# Only build tests: instrumented cross-compiled targets (e.g. the aarch64
# image) cannot link, because the x86_64 LLVM release has no aarch64
# libclang_rt.profile.a.
coverage --build_tests_only
# Merge all tests into bazel-out/_coverage/_coverage_report.dat.
coverage --combined_report=lcov
# By default only the packages of the requested targets are instrumented
# (e.g. //test/... would leave //lib out). Instrument the whole workspace
# except tests and benchmarks.
coverage --instrumentation_filter=^//,-^//test[/:],-^//benchmark[/:]
# NOTE: --experimental_fetch_all_coverage_outputs does not work with
# toolchains_llvm (dangling "gcov" symlink in the _coverage tree artifact).
