<?xml version="1.0"?>
<!--
  Collision Shapes Collection Model
  
  A collection of different collision shapes in one model to demonstrate
  how various geometries interact during collision detection.
  
  Features:
  1. Multiple primitive collision shapes
  2. Different surface properties per shape
  3. Compound collision geometry example
  4. Performance comparison of shape types
-->

<sdf version="1.10">
  <model name="collision_shapes">
    
    <pose>0 0 2 0 0 0</pose>
    
    <!-- Main body (box) -->
    <link name="box_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.33</ixx>
          <iyy>0.33</iyy>
          <izz>0.33</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      
      <collision name="box_collision">
        <geometry>
          <box>
            <size>1 1 1</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <restitution>0.3</restitution>
        </surface>
      </collision>
      
      <visual name="box_visual">
        <geometry>
          <box>
            <size>1 1 1</size>
          </box>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
        </material>
      </visual>
    </link>
    
    <!-- Sphere attachment -->
    <link name="sphere_link">
      <pose>0 0 1.2 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.16</ixx>
          <iyy>0.16</iyy>
          <izz>0.16</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      
      <collision name="sphere_collision">
        <geometry>
          <sphere>
            <radius>0.4</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.5</mu>
              <mu2>0.5</mu2>
            </ode>
          </friction>
          <restitution>0.7</restitution>
        </surface>
      </collision>
      
      <visual name="sphere_visual">
        <geometry>
          <sphere>
            <radius>0.4</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0 1 0 1</ambient>
          <diffuse>0 1 0 1</diffuse>
        </material>
      </visual>
    </link>
    
    <!-- Cylinder attachment -->
    <link name="cylinder_link">
      <pose>1.2 0 0 0 1.57 0</pose>  <!-- Rotated cylinder -->
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.1875</ixx>
          <iyy>0.1875</iyy>
          <izz>0.09375</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      
      <collision name="cylinder_collision">
        <geometry>
          <cylinder>
            <radius>0.3</radius>
            <length>1.0</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
          <restitution>0.2</restitution>
        </surface>
      </collision>
      
      <visual name="cylinder_visual">
        <geometry>
          <cylinder>
            <radius>0.3</radius>
            <length>1.0</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 0 1 1</ambient>
          <diffuse>0 0 1 1</diffuse>
        </material>
      </visual>
    </link>
    
    <!-- Joints connecting the shapes -->
    <joint name="box_sphere_joint" type="fixed">
      <parent>box_link</parent>
      <child>sphere_link</child>
      <pose>0 0 0.8 0 0 0</pose>
    </joint>
    
    <joint name="box_cylinder_joint" type="fixed">
      <parent>box_link</parent>
      <child>cylinder_link</child>
      <pose>0.7 0 0 0 0 0</pose>
    </joint>
    
    <!-- Configuration -->
    <static>false</static>
    <allow_auto_disable>true</allow_auto_disable>
    
  </model>
</sdf>