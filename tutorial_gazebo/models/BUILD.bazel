package(default_visibility = ["//visibility:public"])

# Robot and object model definitions
# SDF models for comprehensive robotics simulation

# Articulated robot model - 6-DOF manipulator
filegroup(
    name = "articulated_robot",
    srcs = ["articulated_robot.sdf"],
)

# Mobile robot model - wheeled robot with sensors
filegroup(
    name = "mobile_robot", 
    srcs = ["mobile_robot.sdf"],
)

# Manipulation objects - various graspable objects
filegroup(
    name = "manipulation_objects",
    srcs = [
        "manipulation_box.sdf",
        "manipulation_sphere.sdf", 
        "manipulation_cylinder.sdf",
    ],
)

# Basic environment models used by tutorial examples
filegroup(
    name = "simple_box",
    srcs = ["simple_box/model.sdf"],
)

filegroup(
    name = "ground_plane",
    srcs = ["ground_plane/model.sdf"],
)

filegroup(
    name = "physics_box",
    srcs = ["physics_box/model.sdf"],
)

filegroup(
    name = "bouncing_ball",
    srcs = ["bouncing_ball/model.sdf"],
)

filegroup(
    name = "pendulum",
    srcs = ["pendulum/model.sdf"],
)

filegroup(
    name = "collision_shapes",
    srcs = ["collision_shapes/model.sdf"],
)

# All robot models
filegroup(
    name = "all_models",
    srcs = [
        ":articulated_robot",
        ":mobile_robot",
        ":manipulation_objects",
        ":simple_box",
        ":ground_plane", 
        ":physics_box",
        ":bouncing_ball",
        ":pendulum",
        ":collision_shapes",
    ],
)