# ============================================================================
# Comprehensive Rendering Demo Collection
# ============================================================================
# 
# This target builds all 5 advanced rendering demonstrations, providing a complete
# educational experience for mastering Gazebo's rendering capabilities:
#
# 1. material_showcase - PBR material workflows and property visualization
# 2. lighting_demo - Advanced lighting systems and shadow optimization  
# 3. camera_demo - Multi-camera sensor systems and rendering pipeline integration
# 4. pbr_explorer - Interactive material artist workflow tools
# 5. visual_effects - Post-processing effects and GPU-accelerated rendering
#
# Build Command: bazelisk build //examples/03_rendering_demo:all_demos
# Educational Value: Complete rendering mastery from basics to advanced techniques
# ============================================================================
filegroup(
    name = "all_demos",
    srcs = [
        ":material_showcase",
        ":lighting_demo",
        ":camera_demo", 
        ":pbr_explorer",
        ":visual_effects",
    ],
)