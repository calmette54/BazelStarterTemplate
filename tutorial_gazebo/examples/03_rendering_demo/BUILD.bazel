load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

# ============================================================================
# Example 3: Advanced Rendering and Visual Effects Demonstration
# ============================================================================
# 
# This comprehensive example explores Gazebo's advanced rendering capabilities:
# - Materials and Physically Based Rendering (PBR) workflows for realistic visuals
# - Lighting systems (directional, point, spot) and shadow optimization techniques  
# - Camera systems, sensor rendering, and multi-view setup for computer vision
# - Interactive PBR parameter exploration for material artist workflows
# - Advanced visual effects, post-processing, and rendering pipeline optimization
#
# Educational Focus:
# - Master PBR material workflows and parameter relationships for production assets
# - Understand lighting types, shadow mapping, and performance optimization strategies
# - Learn camera models, sensor simulation, and multi-camera synchronization techniques
# - Explore visual effects implementation and rendering pipeline optimization
# - Develop rendering performance analysis and GPU utilization optimization skills
# - Apply industry best practices for real-time rendering in simulation environments
#
# Technical Implementation:
# - Hermetic builds with static plugin integration ensure consistent rendering behavior
# - Signal handling infrastructure provides graceful shutdown during long-running demos
# - Real-time performance monitoring with RTF analysis for rendering optimization insights
# - Comprehensive educational progression teaching rendering concepts from basics to advanced
# - Production-ready error handling and resource management for professional workflows
#
# Prerequisites: Basic understanding of 3D graphics concepts and material properties
# Usage: Run individual demos or use run_rendering_demos.sh for complete experience
# ============================================================================

# Material showcase demonstration
# Comprehensive PBR material demonstration with real-time property visualization
cc_binary(
    name = "material_showcase",
    srcs = ["material_showcase.cc"],
    deps = [
        "@gz-sim",
        "@gz-common",
        "@gz-msgs",
        "@gz-transport",
        "@gz-rendering",
        "@gz-math",
        # Hermetic static plugin dependencies for reliable material rendering
        "@gz-sim//:gz-sim-physics-system-static",
        "@gz-sim//:gz-sim-user-commands-system-static",
        "@gz-sim//:gz-sim-scene-broadcaster-system-static",
    ],
    data = [
        "//worlds:lighting_demo",
        "//models:all_models",
    ],
)

