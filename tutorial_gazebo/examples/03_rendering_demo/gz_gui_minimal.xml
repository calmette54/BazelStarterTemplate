<?xml version="1.0" ?>
<!--
  Minimal Gazebo GUI Configuration for 3D Visualization

  This configuration uses only essential plugins that are guaranteed to exist
  in any standard Gazebo installation.
-->

<gui fullscreen="0">

  <!-- Core 3D Scene Visualization -->
  <plugin filename="MinimalScene" name="3D View">
    <gz-gui>
      <title>Material Showcase - 3D View</title>
      <property type="bool" key="showTitleBar">true</property>
      <property type="string" key="state">docked</property>
    </gz-gui>

    <!-- Basic rendering configuration -->
    <engine>ogre2</engine>
    <scene>scene</scene>
    <ambient_light>0.6 0.6 0.6</ambient_light>
    <background_color>0.4 0.4 0.4</background_color>

    <!-- Simple camera positioning -->
    <camera_pose>-8 -8 6 0 0.3 0.78</camera_pose>
  </plugin>

  <!-- World Control (Play/Pause) -->
  <plugin filename="WorldControl" name="World control">
    <gz-gui>
      <title>World Control</title>
      <property type="bool" key="showTitleBar">true</property>
      <property type="string" key="state">floating</property>
      <property key="width" type="double">200</property>
      <property key="height" type="double">100</property>
    </gz-gui>

    <play_pause>true</play_pause>
    <step>true</step>
    <start_paused>false</start_paused>
  </plugin>

  <!-- World Statistics -->
  <plugin filename="WorldStats" name="World stats">
    <gz-gui>
      <title>World Statistics</title>
      <property type="bool" key="showTitleBar">true</property>
      <property type="string" key="state">floating</property>
      <property key="width" type="double">200</property>
      <property key="height" type="double">100</property>
    </gz-gui>

    <sim_time>true</sim_time>
    <real_time>true</real_time>
    <real_time_factor>true</real_time_factor>
    <iterations>true</iterations>
  </plugin>

</gui>
