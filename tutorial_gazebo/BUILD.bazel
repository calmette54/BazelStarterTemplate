load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "pkg_mkdirs")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_cc//cc:defs.bzl", "cc_binary")

# Root package for the Gazebo Tutorial project
package(default_visibility = ["//visibility:public"])

#################################################################################
# Dynamic System Plugins for Gazebo
# Using existing shared libraries provided by gz-sim package
#################################################################################

# Note: We use the existing shared library targets from gz-sim:
# - "@gz-sim//:gz-sim-physics-system.so"
# - "@gz-sim//:gz-sim-user-commands-system.so" 
# - "@gz-sim//:gz-sim-scene-broadcaster-system.so"
# These are already compiled as proper shared libraries for dynamic loading

# Export all tutorial files for packaging
pkg_files(
    name = "tutorial_files",
    srcs = [
        "MODULE.bazel",
        "README.md",
    ],
    prefix = "tutorial_gazebo",
)

# Create directories for the package structure
pkg_mkdirs(
    name = "tutorial_dirs",
    dirs = [
        "tutorial_gazebo/examples",
        "tutorial_gazebo/worlds", 
        "tutorial_gazebo/models",
        "tutorial_gazebo/plugins",
        "tutorial_gazebo/launch",
    ],
)

# Package all tutorial components
pkg_tar(
    name = "tutorial_gazebo_package",
    srcs = [
        ":tutorial_files",
        ":tutorial_dirs",
        "//examples:all_examples",
        "//worlds:all_worlds",
        "//models:all_models",
    ],
    package_dir = "/",
    strip_prefix = ".",
)

# Convenience target to run all examples
sh_binary(
    name = "run_all_examples",
    srcs = ["scripts/run_all_examples.sh"],
    data = [
        "//examples:all_examples",
        "//worlds:all_worlds",
        "//models:all_models",
    ],
)

# Development utilities
filegroup(
    name = "all_sdf_files",
    srcs = [
        "//worlds:all_worlds",
        "//models:all_models",
    ],
)

# Format all SDF files using rules (when available)
genrule(
    name = "format_sdf",
    srcs = [":all_sdf_files"],
    outs = ["format_sdf.stamp"],
    cmd = """
        echo "SDF files formatted" > $@
        # Future: integrate SDF formatting tools here
    """,
)