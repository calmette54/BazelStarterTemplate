package(default_visibility = ["//visibility:public"])

# World files for all tutorial examples
# Each world demonstrates specific concepts and features

filegroup(
    name = "all_worlds", 
    srcs = [
        "basic_world.sdf",
        "basic_world_tutorial.sdf",
        "lighting_demo.sdf",
        "physics_playground.sdf",
        "rendering_showcase.sdf",
        "sensor_testing.sdf",
        "transport_demo.sdf",
        "robot_arena.sdf",
        "advanced_features.sdf",
    ],
)

