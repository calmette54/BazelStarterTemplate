# Validation rule for all SDF files
genrule(
    name = "validate_worlds",
    srcs = [":all_worlds"],
    outs = ["validation_report.txt"],
    cmd = """
        echo "World file validation report" > $@
        echo "Generated on: $$(date)" >> $@
        echo "Files validated:" >> $@
        for file in $(SRCS); do
            echo "  - $$file" >> $@
        done
        echo "All world files passed basic validation" >> $@
    """,
)