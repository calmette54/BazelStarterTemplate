<?xml version="1.0" ?>
<sdf version="1.10">
  <!-- Standalone LiDAR Platform Model for Runtime Injection -->
  <model name="lidar_platform">
    <pose>0 0 1 0 0 0</pose>
    <static>false</static>

    <!-- Base platform -->
    <link name="base_link">
      <gravity>false</gravity>
      <visual name="visual">
        <geometry>
          <box><size>1 1 0.2</size></box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- 3D LiDAR -->
    <link name="lidar_3d_link">
      <gravity>false</gravity>
      <pose>0 0 0.5 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 0 1 1</ambient>
          <diffuse>0.2 0.2 1 1</diffuse>
        </material>
      </visual>
      <sensor name="lidar_3d" type="gpu_lidar">
        <!-- Topic will be dynamically generated based on world name -->
        <topic>/world/WORLD_NAME_PLACEHOLDER/model/lidar_platform/link/lidar_3d_link/sensor/lidar_3d/scan</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>32</samples>
              <resolution>1</resolution>
              <min_angle>-0.5236</min_angle>
              <max_angle>0.5236</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>50</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
        <always_on>1</always_on>
        <update_rate>5</update_rate>
        <visualize>true</visualize>
      </sensor>
    </link>

    <!-- Joints -->
    <joint name="lidar_3d_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_3d_link</child>
    </joint>
  </model>
</sdf>