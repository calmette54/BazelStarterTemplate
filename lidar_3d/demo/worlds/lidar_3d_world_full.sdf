<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="lidar_world">

    <!-- Physics -->
    <physics name="default" type="ode">
      <max_step_size>0.033333</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- GUI Configuration -->
    <gui fullscreen="0">
      <!-- 3D Scene -->
      <plugin filename="GzScene3D" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>1.0 1.0 1.0</ambient_light>
        <background_color>0.4 0.4 0.4</background_color>
        <camera_pose>-6 0 6 0 0.5 0</camera_pose>
        <sky>true</sky>
      </plugin>

      <!-- Transform Control -->
      <plugin filename="TransformControl" name="Transform control">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>

      <!-- World control -->
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <service>/world/lidar_world</service>
      </plugin>

      <!-- World statistics -->
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <!-- 3D LiDAR Visualization Plugin -->
      <plugin filename="VisualizeLidar" name="Visualize Lidar">
        <gz-gui>
          <title>Visualize Lidar</title>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>

      <!-- Keyboard Input Plugin for movement controls -->
      <plugin filename="KeyPublisher" name="Key Publisher">
        <gz-gui>
          <title>Key Publisher</title>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>

      <!-- Topic Echo Plugin for debugging topics -->
      <plugin filename="TopicEcho" name="Topic Echo">
        <gz-gui>
          <title>Topic Echo</title>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>

      <!-- Marker Manager - Required for Point Cloud visualization -->
      <plugin filename="MarkerManager" name="Marker manager">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <world_name>lidar_world</world_name>
      </plugin>

      <!-- Entity tree -->
      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>

      <!-- Component inspector -->
      <plugin filename="ComponentInspector" name="Component inspector">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>
    </gui>

    <!-- Office Floor -->
    <model name="office_floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>15 12 0.1</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>15 12 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.85 1</ambient>
            <diffuse>0.95 0.95 0.9 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Office Walls -->
    <!-- North Wall -->
    <model name="wall_north">
      <pose>0 6 1.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>15 0.2 3</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>15 0.2 3</size></box>
          </geometry>
          <material>
            <ambient>0.92 0.92 0.9 1</ambient>
            <diffuse>0.95 0.95 0.92 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- South Wall -->
    <model name="wall_south">
      <pose>0 -6 1.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>15 0.2 3</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>15 0.2 3</size></box>
          </geometry>
          <material>
            <ambient>0.92 0.92 0.9 1</ambient>
            <diffuse>0.95 0.95 0.92 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- East Wall -->
    <model name="wall_east">
      <pose>7.5 0 1.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 12 3</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 12 3</size></box>
          </geometry>
          <material>
            <ambient>0.92 0.92 0.9 1</ambient>
            <diffuse>0.95 0.95 0.92 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- West Wall with Door Opening -->
    <model name="wall_west_1">
      <pose>-7.5 -3 1.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 6 3</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 6 3</size></box>
          </geometry>
          <material>
            <ambient>0.92 0.92 0.9 1</ambient>
            <diffuse>0.95 0.95 0.92 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west_2">
      <pose>-7.5 3 1.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 6 3</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 6 3</size></box>
          </geometry>
          <material>
            <ambient>0.92 0.92 0.9 1</ambient>
            <diffuse>0.95 0.95 0.92 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Ceiling -->
    <model name="office_ceiling">
      <pose>0 0 3.1 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>15 12 0.2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>15 12 0.2</size></box>
          </geometry>
          <material>
            <ambient>0.98 0.98 0.96 1</ambient>
            <diffuse>1.0 1.0 0.98 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- LiDAR platform -->
    <model name="lidar_platform">
      <pose>0 0 1 0 0 0</pose>
      <static>false</static>

      <!-- Base platform -->
      <link name="base_link">
        <!-- Disable gravity for this link -->
        <gravity>false</gravity>
        <collision name="collision">
          <geometry>
            <box><size>1 1 0.2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1 1 0.2</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- 3D LiDAR -->
      <link name="lidar_3d_link">
        <!-- Disable gravity for this link -->
        <gravity>false</gravity>
        <pose>0 0 0.5 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.15</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0.2 0.2 1 1</diffuse>
          </material>
        </visual>
        <sensor name="lidar_3d" type="gpu_lidar">
          <topic>/world/lidar_world/model/lidar_platform/link/lidar_3d_link/sensor/lidar_3d/scan</topic>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
              <vertical>
                <samples>32</samples>
                <resolution>1</resolution>
                <min_angle>-0.5236</min_angle>
                <max_angle>0.5236</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.1</min>
              <max>50</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
          <always_on>1</always_on>
          <update_rate>5</update_rate>
          <visualize>true</visualize>
        </sensor>
      </link>

      <!-- Joints -->
      <joint name="lidar_3d_joint" type="fixed">
        <parent>base_link</parent>
        <child>lidar_3d_link</child>
      </joint>
    </model>

    <!-- Office Workstations -->
    <!-- Workstation 1 - Near Reception -->
    <model name="desk_1">
      <pose>-5 -3 0.4 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.6 0.8 0.8</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.6 0.8 0.8</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.6 0.5 0.4 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="office_chair_1">
      <pose>-5 -3.8 0.45 0 0 0</pose>
