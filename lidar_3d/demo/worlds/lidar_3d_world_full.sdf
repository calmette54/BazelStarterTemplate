    <!-- Office Lighting System -->
    <!-- Main Ceiling Lights -->
    <light name="ceiling_light_1" type="point">
      <pose>-3 2 2.8 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>15</range>
        <linear>0.1</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light name="ceiling_light_2" type="point">
      <pose>3 2 2.8 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>15</range>
        <linear>0.1</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light name="ceiling_light_3" type="point">
      <pose>-3 -2 2.8 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>15</range>
        <linear>0.1</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light name="ceiling_light_4" type="point">
      <pose>3 -2 2.8 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>15</range>
        <linear>0.1</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- Reception Area Light -->
    <light name="reception_light" type="point">
      <pose>-5 0 2.8 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.95 0.95 0.9 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
      <attenuation>
        <range>12</range>
        <linear>0.15</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
    </light>

    <!-- Meeting Room Light -->
    <light name="meeting_light" type="point">
      <pose>5 4 2.8 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>10</range>
        <linear>0.1</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- Ambient Light for Realism -->
    <light name="ambient_fill" type="directional">
      <pose>0 0 5 0.2 0.2 0</pose>
      <cast_shadows>true</cast_shadows>
      <direction>0 0 -1</direction>
      <diffuse>0.4 0.4 0.38 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <intensity>0.5</intensity>
    </light>

    <!-- Strategic Testing Obstacles at Various Heights -->
    <!-- Low obstacles (0.2m height) - ankle/wheel level -->
    <model name="low_obstacle_1">
      <pose>1 1 0.1 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.8 0.3 0.2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.8 0.3 0.2</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.7 0.5 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="low_obstacle_2">
      <pose>-2 -1.5 0.1 0 0 0.78</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.6 0.4 0.2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.6 0.4 0.2</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.7 0.5 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Medium obstacles (0.8m height) - waist level -->
    <model name="medium_obstacle_1">
      <pose>0.5 -0.5 0.4 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>0.8</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>0.8</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="medium_obstacle_2">
      <pose>-1 2 0.4 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.3 0.3 0.8</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.3 0.3 0.8</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.7 1</ambient>
            <diffuse>0.6 0.6 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- High obstacles (1.8m height) - head level -->
    <model name="high_obstacle_1">
      <pose>2.5 0.5 0.9 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 0.2 1.8</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 0.2 1.8</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.5 0.4 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Hanging obstacles (ceiling suspended) -->
    <model name="hanging_obstacle_1">
      <pose>-0.5 0 2.3 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.6 0.4 0.6</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.6 0.4 0.6</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- LiDAR Challenge Objects - Reflective and Occluding -->
    <!-- Reflective metal cabinet (high reflectivity) -->
    <model name="reflective_cabinet">
      <pose>6 2 0.75 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.6 0.4 1.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.6 0.4 1.5</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Glass partition (transparent/reflective) -->
    <model name="glass_partition">
      <pose>-3 0 1 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.05 2 2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.05 2 2</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.9 1.0 0.3</ambient>
            <diffuse>0.9 0.95 1.0 0.3</diffuse>
            <specular>0.9 0.9 0.9 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Complex occlusion structure (L-shaped) -->
    <model name="complex_occluder">
      <pose>1.5 -2.5 0.5 0 0 0</pose>
      <static>true</static>
      <link name="link1">
        <pose>0 0 0 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>1.2 0.2 1</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.2 0.2 1</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.3 0.2 1</ambient>
            <diffuse>0.7 0.5 0.4 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="link2">
        <pose>0.5 0.5 0 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>0.2 1 1</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 1 1</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.3 0.2 1</ambient>
            <diffuse>0.7 0.5 0.4 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="complex_joint" type="fixed">
        <parent>link1</parent>
        <child>link2</child>
      </joint>
    </model>

    <!-- Curved reflective surface (cylindrical) -->
    <model name="curved_reflector">
      <pose>-2.5 2.5 0.6 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>1.2</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>1.2</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.9 1</ambient>
            <diffuse>0.9 0.9 0.95 1</diffuse>
            <specular>0.7 0.7 0.7 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Multi-level shelf with partial occlusion -->
    <model name="test_shelf">
      <pose>4.5 -4 1 0 0 0</pose>
      <static>true</static>
      <link name="shelf_base">
        <collision name="collision">
          <geometry>
            <box><size>0.8 0.3 2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.8 0.3 2</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.6 0.5 0.4 1</diffuse>
          </material>
        </visual>
      </link>
      <!-- Add shelf items that create partial occlusion -->
      <link name="shelf_item_1">
        <pose>-0.2 0.2 0.3 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>0.15 0.1 0.3</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.15 0.1 0.3</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.9 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="shelf_item_2">
        <pose>0.1 0.2 -0.2 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.4</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.4</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.3 0.9 0.3 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="shelf_joint_1" type="fixed">
        <parent>shelf_base</parent>
        <child>shelf_item_1</child>
      </joint>
      <joint name="shelf_joint_2" type="fixed">
        <parent>shelf_base</parent>
        <child>shelf_item_2</child>
      </joint>
    </model>

  </world>
</sdf>
