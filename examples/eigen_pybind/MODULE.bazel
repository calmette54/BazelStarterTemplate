# Python bindings for an Eigen-based C++ library, built with pybind11.
#
# A separate Bazel module: build it from this directory, not from the
# repository root (the root .bazelignore skips examples/).
module(name = "example_eigen_pybind")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "eigen", version = "3.4.1.bcr.2")

# The C++ library, shared with examples/eigen_go
bazel_dep(name = "example_eigen_math")
local_path_override(
    module_name = "example_eigen_math",
    path = "../eigen_math",
)
bazel_dep(name = "pybind11_bazel", version = "2.13.6")
bazel_dep(name = "googletest", version = "1.18.0.bcr.1", dev_dependency = True)

# Same hermetic LLVM toolchain as the template (symlink to
# ../../bzl/toolchains.MODULE.bazel).
include("//:toolchains.MODULE.bazel")

#--------------------- Python Toolchain --------------
bazel_dep(name = "rules_python", version = "2.4.5")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = "3.12",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "pypi")
