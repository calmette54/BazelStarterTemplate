# ============================================================================
# 3D Visualization Demo Launchers
# ============================================================================
# These shell script wrappers launch the demos with complete 3D visualization
# by integrating gz::sim::Server with gz-gui built from source.

# Material Showcase with 3D Visualization
genrule(
    name = "material_showcase_3d",
    outs = ["material_showcase_3d.sh"],
    cmd = '''cat > $@ << 'EOF'
#!/bin/bash
# Material Showcase 3D Visualization Launcher
echo "=========================================="
echo "TUTORIAL: Material Showcase with 3D GUI"
echo "=========================================="
echo "Requirements: Qt5/Qt6 must be installed"
echo "  Ubuntu/Debian: sudo apt install qt5-default libqt5widgets5-dev"
echo "  Fedora: sudo dnf install qt5-qtbase-devel qt5-qtwidgets-devel"
echo "  macOS: brew install qt@5"
echo ""

# Find the demo_launcher binary
LAUNCHER="$$(pwd)/$(location :demo_launcher)"
WORLD_FILE="$$(pwd)/$(location //worlds:material_showcase_visual)"

if [[ ! -f "$$LAUNCHER" ]]; then
    echo "ERROR: demo_launcher not found at $$LAUNCHER"
    echo "Run: bazelisk build //examples/03_rendering_demo:demo_launcher"
    exit 1
fi

# Launch with proper arguments
exec "$$LAUNCHER" "Material Showcase" "$$WORLD_FILE"
EOF
chmod +x $@''',
    tools = [
        ":demo_launcher",
        "//worlds:material_showcase_visual",
    ],
    executable = True,
)

# Lighting Demo with 3D Visualization
genrule(
    name = "lighting_demo_3d",
    outs = ["lighting_demo_3d.sh"],
    cmd = '''cat > $@ << 'EOF'
#!/bin/bash
# Lighting Demo 3D Visualization Launcher
echo "======================================="
echo "TUTORIAL: Lighting Demo with 3D GUI"
echo "======================================="
echo "Requirements: Qt5/Qt6 must be installed"
echo ""

LAUNCHER="$$(pwd)/$(location :demo_launcher)"
WORLD_FILE="$$(pwd)/$(location //worlds:lighting_demo_visual)"

if [[ ! -f "$$LAUNCHER" ]]; then
    echo "ERROR: demo_launcher not found"
    echo "Run: bazelisk build //examples/03_rendering_demo:demo_launcher"
    exit 1
fi

exec "$$LAUNCHER" "Lighting Demo" "$$WORLD_FILE"
EOF
chmod +x $@''',
    tools = [
        ":demo_launcher",
        "//worlds:lighting_demo_visual",
    ],
    executable = True,
)

# ============================================================================
# Comprehensive Rendering Demo Collection
# ============================================================================
#
# This target builds all 5 advanced rendering demonstrations, providing a complete
# educational experience for mastering Gazebo's rendering capabilities:
#
# 1. material_showcase - PBR material workflows and property visualization
# 2. lighting_demo - Advanced lighting systems and shadow optimization
# 3. camera_demo - Multi-camera sensor systems and rendering pipeline integration
# 4. pbr_explorer - Interactive material artist workflow tools
# 5. visual_effects - Post-processing effects and GPU-accelerated rendering
#
# Build Command: bazelisk build //examples/03_rendering_demo:all_demos
# Educational Value: Complete rendering mastery from basics to advanced techniques
# ============================================================================
filegroup(
    name = "all_demos",
    srcs = [
        ":material_showcase",
        ":lighting_demo",
        ":camera_demo",
        ":pbr_explorer",
        ":visual_effects",
    ],
)
