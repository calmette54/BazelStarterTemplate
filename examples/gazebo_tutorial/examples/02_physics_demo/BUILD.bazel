        "@gz-common//:gz-common",
        "@gz-msgs//:gz-msgs",
        "@gz-transport//:gz-transport",
        "@gz-math//:gz-math",
        # Hermetic static plugin integration for reliable collision detection
        "@gz-sim//:gz-sim-physics-system-static",
        "@gz-sim//:gz-sim-contact-system-static",
        "@gz-sim//:gz-sim-user-commands-system-static",
        "@gz-sim//:gz-sim-scene-broadcaster-system-static",
    ],
    data = [
        "//worlds:collision_demo_world",
        "//models:all_models",
        "//config:server_config",
    ],
    env = {
        "GZ_SIM_SERVER_CONFIG_PATH": "$(location //config:server_config)",
    },
)

