# Physics configuration utility
# Interactive tool for configuring and tuning physics engine parameters
cc_binary(
    name = "physics_configurator",
    srcs = ["physics_configurator.cc"],
    deps = [
        "@gz-sim//:gz-sim",
        "@gz-common//:gz-common",
        "@gz-msgs//:gz-msgs",
        "@gz-transport//:gz-transport",
        "@gz-math//:gz-math",
        # Hermetic static plugin integration for configuration management
