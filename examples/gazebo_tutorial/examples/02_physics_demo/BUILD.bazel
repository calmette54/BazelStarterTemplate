    ],
    env = {
        "GZ_SIM_SERVER_CONFIG_PATH": "$(location //config:server_config)",
    },
)

# Convenience target to build all physics demos
filegroup(
    name = "all_demos",
    srcs = [
        ":physics_comparison",
        ":collision_demo",
        ":joint_demo",
        ":physics_benchmark",
        ":physics_configurator",
    ],
)