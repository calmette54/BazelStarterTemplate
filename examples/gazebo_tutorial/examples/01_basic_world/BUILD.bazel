load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

# Example 1: Basic World Creation
# Demonstrates fundamental concepts:
# - SDF world format and structure
# - Basic model creation and positioning
# - Lighting setup and configuration
# - Ground plane and basic physics

cc_binary(
    name = "basic_world_demo",
    srcs = ["basic_world_demo.cc"],
    deps = [
        "@gz-sim//:gz-sim",
        "@gz-common//:gz-common", 
        "@gz-math//:gz-math",
        "@gz-transport//:gz-transport",
        # Hermetic static plugin integration for reliable builds
        # Note: This approach ensures all plugins are available without complex runtime dependencies
        "@gz-sim//:gz-sim-physics-system-static",
        "@gz-sim//:gz-sim-user-commands-system-static",
        "@gz-sim//:gz-sim-scene-broadcaster-system-static",
    ],
    data = [
        "//worlds:basic_world",
        "//worlds:basic_world_simple", 
        "//worlds:basic_world_tutorial",
        "//models:simple_box",
        "//models:ground_plane",
        "//config:server_config",
    ],
    env = {
        "GZ_SIM_SERVER_CONFIG_PATH": "$(location //config:server_config)",
    },
)

# Interactive world viewer
cc_binary(
    name = "world_viewer",
    srcs = ["world_viewer.cc"],
    deps = [
        "@gz-sim//:gz-sim",
        "@gz-common//:gz-common",
        # Link static system plugins directly into binary for hermetic execution
        "@gz-sim//:gz-sim-physics-system-static",
        "@gz-sim//:gz-sim-user-commands-system-static",
        "@gz-sim//:gz-sim-scene-broadcaster-system-static",
    ],
    data = [
        "//worlds:basic_world_simple",
        "//worlds:basic_world_tutorial",
        "//worlds:lighting_demo.sdf",
        "//config:server_config",
    ],
    env = {
        "GZ_SIM_SERVER_CONFIG_PATH": "$(location //config:server_config)",
    },
)

# SDF validation tool
filegroup(
    name = "all_demos",
    srcs = [
        ":basic_world_demo",
        ":world_viewer", 
    ],
)