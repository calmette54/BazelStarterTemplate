<?xml version="1.0"?>
<!-- Minimal Gazebo Server Configuration -->
<server version="1.0">
  <!-- Network configuration -->
  <network>
    <master_uri>http://localhost:11345</master_uri>
    <timeout>2000</timeout>
  </network>
  
  <!-- Plugin search paths -->
  <plugin_paths>
    <path>.</path>
  </plugin_paths>
  
  <!-- Resource paths -->
  <resource_paths>
    <path>.</path>
    <path>worlds</path>
    <path>models</path>
  </resource_paths>
  
  <!-- Logging configuration -->
  <log>
    <level>info</level>
  </log>
</server>