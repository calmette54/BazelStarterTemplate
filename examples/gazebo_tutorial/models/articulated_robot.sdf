<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="articulated_robot">
    <!-- 6-DOF Articulated Robot Manipulator -->
    <!-- Comprehensive robot model with sensors, actuators, and controllers -->
    
    <pose>0 0 0.05 0 0 0</pose>
    
    <!-- Base Link -->
    <link name="base_link">
      <pose>0 0 0.05 0 0 0</pose>
      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>0.5</ixx>
          <iyy>0.5</iyy>
          <izz>0.5</izz>
        </inertia>
      </inertial>
      
      <collision name="base_collision">
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
      </collision>
      
      <visual name="base_visual">
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>
      
      <!-- IMU sensor in base -->
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0.05 0 0 0</pose>
        <update_rate>100</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.005</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.005</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.005</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.05</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.05</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.05</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>
    
    <!-- Link 1 -->
    <link name="link_1">
      <pose>0 0 0.15 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.1</ixx>
          <iyy>0.1</iyy>
          <izz>0.05</izz>
        </inertia>
      </inertial>
      
      <collision name="link_1_collision">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.25</length>
          </cylinder>
        </geometry>
      </collision>
      
      <visual name="link_1_visual">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.25</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.4 0.8 1</ambient>
          <diffuse>0.3 0.5 0.9 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>
    </link>
    
    <!-- Joint 1 - Base rotation -->
    <joint name="joint_1" type="revolute">
      <parent>base_link</parent>
      <child>link_1</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14159</lower>
          <upper>3.14159</upper>
          <effort>100</effort>
          <velocity>2.0</velocity>
        </limit>
        <dynamics>
          <damping>1.0</damping>
          <friction>0.1</friction>
        </dynamics>
      </axis>
    </joint>
    
    <!-- Link 2 -->
    <link name="link_2">
      <pose>0 0 0.4 0 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.08</ixx>
          <iyy>0.08</iyy>
          <izz>0.03</izz>
        </inertia>
      </inertial>
      
      <collision name="link_2_collision">
        <geometry>
          <box><size>0.12 0.08 0.3</size></box>
        </geometry>
      </collision>
      
      <visual name="link_2_visual">
        <geometry>
          <box><size>0.12 0.08 0.3</size></box>
        </geometry>
        <material>
          <ambient>0.8 0.4 0.2 1</ambient>
          <diffuse>0.9 0.5 0.3 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>
    </link>
    
    <!-- Joint 2 - Shoulder -->
    <joint name="joint_2" type="revolute">
      <parent>link_1</parent>
      <child>link_2</child>
      <pose>0 0 -0.15 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.57079</lower>
          <upper>1.57079</upper>
          <effort>80</effort>
          <velocity>1.5</velocity>
        </limit>
        <dynamics>
          <damping>0.8</damping>
          <friction>0.08</friction>
        </dynamics>
      </axis>
    </joint>
    
    <!-- Link 3 -->
    <link name="link_3">
      <pose>0 0 0.7 0 0 0</pose>
      <inertial>
        <mass>1.2</mass>
        <inertial_pose>0 0 0.1 0 0 0</inertial_pose>
        <inertia>
          <ixx>0.06</ixx>
          <iyy>0.06</iyy>
          <izz>0.02</izz>
        </inertia>
      </inertial>
      
      <collision name="link_3_collision">
        <geometry>
          <box><size>0.10 0.06 0.25</size></box>
        </geometry>
      </collision>
      
      <visual name="link_3_visual">
        <geometry>
          <box><size>0.10 0.06 0.25</size></box>
        </geometry>
        <material>
          <ambient>0.2 0.8 0.4 1</ambient>
          <diffuse>0.3 0.9 0.5 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>
    </link>
    
    <!-- Joint 3 - Elbow -->
    <joint name="joint_3" type="revolute">
      <parent>link_2</parent>
      <child>link_3</child>
      <pose>0 0 -0.125 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-2.09439</lower>
          <upper>0.5236</upper>
          <effort>60</effort>
          <velocity>2.0</velocity>
        </limit>
        <dynamics>
          <damping>0.6</damping>
          <friction>0.06</friction>
        </dynamics>
      </axis>
    </joint>
    
    <!-- Link 4 - Wrist 1 -->
    <link name="link_4">
      <pose>0 0 0.9 0 0 0</pose>
      <inertial>
        <mass>0.8</mass>
        <inertia>
          <ixx>0.03</ixx>
          <iyy>0.03</iyy>
          <izz>0.015</izz>
        </inertia>
      </inertial>
      
      <collision name="link_4_collision">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
      </collision>
      
      <visual name="link_4_visual">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.2 0.8 1</ambient>
          <diffuse>0.9 0.3 0.9 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>
    </link>
    
    <!-- Joint 4 - Wrist roll -->
    <joint name="joint_4" type="revolute">
      <parent>link_3</parent>
      <child>link_4</child>
      <pose>0 0 -0.075 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-3.14159</lower>
          <upper>3.14159</upper>
          <effort>40</effort>
          <velocity>3.0</velocity>
        </limit>
        <dynamics>
          <damping>0.4</damping>
          <friction>0.04</friction>
        </dynamics>
      </axis>
    </joint>
    
    <!-- Link 5 - Wrist 2 -->
    <link name="link_5">
      <pose>0 0 1.05 0 0 0</pose>
      <inertial>
        <mass>0.6</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.01</izz>
        </inertia>
      </inertial>
      
      <collision name="link_5_collision">
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </collision>
      
      <visual name="link_5_visual">
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.2 1</ambient>
          <diffuse>0.9 0.9 0.3 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>
    </link>
    
    <!-- Joint 5 - Wrist pitch -->
    <joint name="joint_5" type="revolute">
      <parent>link_4</parent>
      <child>link_5</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.57079</lower>
          <upper>1.57079</upper>
          <effort>30</effort>
          <velocity>3.0</velocity>
        </limit>
        <dynamics>
          <damping>0.3</damping>
          <friction>0.03</friction>
        </dynamics>
      </axis>
    </joint>
    
    <!-- End Effector -->
    <link name="end_effector">
      <pose>0 0 1.15 0 0 0</pose>
      <inertial>
        <mass>0.4</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.005</izz>
        </inertia>
      </inertial>
      
      <collision name="end_effector_collision">
        <geometry>
          <box><size>0.08 0.08 0.06</size></box>
        </geometry>
      </collision>
      
      <visual name="end_effector_visual">
        <geometry>
          <box><size>0.08 0.08 0.06</size></box>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
        </material>
      </visual>
      
      <!-- Camera sensor on end effector -->
      <sensor name="end_effector_camera" type="camera">
        <pose>0.04 0 0 0 0 0</pose>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.01</near>
            <far>5.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.005</stddev>
          </noise>
        </camera>
      </sensor>
    </link>
    
    <!-- Joint 6 - End effector rotation -->
    <joint name="joint_6" type="revolute">
      <parent>link_5</parent>
      <child>end_effector</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-3.14159</lower>
          <upper>3.14159</upper>
          <effort>20</effort>
          <velocity>4.0</velocity>
        </limit>
        <dynamics>
          <damping>0.2</damping>
          <friction>0.02</friction>
        </dynamics>
      </axis>
    </joint>
    
    <!-- Joint Position Controllers -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint_1</joint_name>
      <topic>/model/articulated_robot/joint/joint_1/cmd_pos</topic>
      <p_gain>1000</p_gain>
      <i_gain>50</i_gain>
      <d_gain>10</d_gain>
      <i_max>1000</i_max>
      <i_min>-1000</i_min>
      <cmd_max>100</cmd_max>
      <cmd_min>-100</cmd_min>
    </plugin>
    
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint_2</joint_name>
      <topic>/model/articulated_robot/joint/joint_2/cmd_pos</topic>
      <p_gain>800</p_gain>
      <i_gain>40</i_gain>
      <d_gain>8</d_gain>
      <i_max>800</i_max>
      <i_min>-800</i_min>
      <cmd_max>80</cmd_max>
      <cmd_min>-80</cmd_min>
    </plugin>
    
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint_3</joint_name>
      <topic>/model/articulated_robot/joint/joint_3/cmd_pos</topic>
      <p_gain>600</p_gain>
      <i_gain>30</i_gain>
      <d_gain>6</d_gain>
      <i_max>600</i_max>
      <i_min>-600</i_min>
      <cmd_max>60</cmd_max>
      <cmd_min>-60</cmd_min>
    </plugin>
    
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint_4</joint_name>
      <topic>/model/articulated_robot/joint/joint_4/cmd_pos</topic>
      <p_gain>400</p_gain>
      <i_gain>20</i_gain>
      <d_gain>4</d_gain>
      <i_max>400</i_max>
      <i_min>-400</i_min>
      <cmd_max>40</cmd_max>
      <cmd_min>-40</cmd_min>
    </plugin>
    
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint_5</joint_name>
      <topic>/model/articulated_robot/joint/joint_5/cmd_pos</topic>
      <p_gain>300</p_gain>
      <i_gain>15</i_gain>
      <d_gain>3</d_gain>
      <i_max>300</i_max>
      <i_min>-300</i_min>
      <cmd_max>30</cmd_max>
      <cmd_min>-30</cmd_min>
    </plugin>
    
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint_6</joint_name>
      <topic>/model/articulated_robot/joint/joint_6/cmd_pos</topic>
      <p_gain>200</p_gain>
      <i_gain>10</i_gain>
      <d_gain>2</d_gain>
      <i_max>200</i_max>
      <i_min>-200</i_min>
      <cmd_max>20</cmd_max>
      <cmd_min>-20</cmd_min>
    </plugin>
    
    <!-- Joint State Publisher -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <update_rate>100</update_rate>
      <joint_name>joint_1</joint_name>
      <joint_name>joint_2</joint_name>
      <joint_name>joint_3</joint_name>
      <joint_name>joint_4</joint_name>
      <joint_name>joint_5</joint_name>
      <joint_name>joint_6</joint_name>
      <topic>/model/articulated_robot/joint_states</topic>
    </plugin>
    
    <!-- Pose Publisher -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <update_rate>50</update_rate>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>true</static_publisher>
      <static_update_frequency>1</static_update_frequency>
    </plugin>
    
  </model>
</sdf>