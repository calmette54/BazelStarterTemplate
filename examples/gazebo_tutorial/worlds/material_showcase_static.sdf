<?xml version="1.0" ?>
<!--
  Gazebo Tutorial - Material Showcase Static World

  This world demonstrates Physically Based Rendering (PBR) materials with static plugin integration.
  No plugins are declared in the SDF - they are statically linked via Bazel.

  Features:
  - PBR material showcase with multiple material types
  - Professional 3-point lighting setup
  - Static plugin integration (Physics, UserCommands, SceneBroadcaster)
  - Optimized for hermetic builds and reliable 3D visualization
-->

<sdf version="1.10">
  <world name="material_showcase">

    <!-- Physics with stable timestep for smooth visualization -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- System plugins - will fail to load but trigger static plugin defaults -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Professional 3-Point Lighting Setup for Material Visualization -->

    <!-- Key Light: Primary illumination from upper right -->
    <light name="key_light" type="directional">
      <pose>8 8 12 -0.5 -0.3 -0.785</pose>
      <cast_shadows>true</cast_shadows>
      <direction>-0.5 -0.5 -1.0</direction>
      <diffuse>0.9 0.9 0.8 1.0</diffuse>
      <specular>0.7 0.7 0.6 1.0</specular>
      <attenuation>
        <range>50</range>
      </attenuation>
    </light>

    <!-- Fill Light: Softer illumination from left to reduce shadows -->
    <light name="fill_light" type="directional">
      <pose>-6 8 10 -0.3 0.2 0.785</pose>
      <cast_shadows>false</cast_shadows>
      <direction>0.4 -0.4 -0.8</direction>
      <diffuse>0.6 0.6 0.8 1.0</diffuse>
      <specular>0.3 0.3 0.4 1.0</specular>
      <attenuation>
        <range>40</range>
      </attenuation>
    </light>

    <!-- Rim Light: Backlighting to separate objects from background -->
    <light name="rim_light" type="directional">
      <pose>0 -10 8 0.3 0.0 0.0</pose>
      <cast_shadows>false</cast_shadows>
      <direction>0.0 1.0 -0.3</direction>
      <diffuse>0.5 0.5 0.6 1.0</diffuse>
      <specular>0.6 0.6 0.7 1.0</specular>
      <attenuation>
        <range>35</range>
      </attenuation>
    </light>

    <!-- Ambient light for overall scene illumination -->
    <light name="ambient_light" type="directional">
      <pose>0 0 20 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <direction>0 0 -1</direction>
      <diffuse>0.3 0.3 0.4 1.0</diffuse>
      <specular>0.1 0.1 0.1 1.0</specular>
    </light>

    <!-- Ground Plane with Neutral Material -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>25 25</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>25 25</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1.0</ambient>
            <diffuse>0.7 0.7 0.7 1.0</diffuse>
            <specular>0.2 0.2 0.2 1.0</specular>
            <pbr>
              <metal>
                <metalness>0.0</metalness>
                <roughness>0.7</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Material Showcase Objects -->

    <!-- Primary Showcase Sphere - Center Stage -->
    <model name="showcase_sphere">
      <pose>0 0 1.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.8</ixx>
            <iyy>0.8</iyy>
            <izz>0.8</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>1.2</radius>
            </sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>1.2</radius>
            </sphere>
          </geometry>
          <!-- Dynamic PBR Material - Red Plastic Base -->
          <material>
            <ambient>0.2 0.05 0.05 1.0</ambient>
            <diffuse>0.8 0.1 0.1 1.0</diffuse>
            <specular>0.4 0.4 0.4 1.0</specular>
            <emissive>0.0 0.0 0.0 1.0</emissive>
            <pbr>
              <metal>
                <metalness>0.0</metalness>
                <roughness>0.3</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Comparison Objects - Different Geometries -->

    <!-- Metallic Cube -->
    <model name="metallic_cube">
      <pose>-4 0 1.0 0 0 0.785</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.8 1.8 1.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.8 1.8 1.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.35 1.0</ambient>
            <diffuse>0.7 0.7 0.8 1.0</diffuse>
            <specular>0.9 0.9 0.9 1.0</specular>
            <emissive>0.0 0.0 0.0 1.0</emissive>
            <pbr>
              <metal>
                <metalness>0.9</metalness>
                <roughness>0.1</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Ceramic Cylinder -->
    <model name="ceramic_cylinder">
      <pose>4 0 1.0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.9</radius>
              <length>2.2</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.9</radius>
              <length>2.2</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.85 0.9 0.8 1.0</ambient>
            <diffuse>0.95 1.0 0.9 1.0</diffuse>
            <specular>0.5 0.5 0.5 1.0</specular>
            <emissive>0.0 0.0 0.0 1.0</emissive>
            <pbr>
              <metal>
                <metalness>0.0</metalness>
                <roughness>0.4</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Glass Torus -->
    <model name="glass_torus">
      <pose>0 -3.5 1.2 1.5708 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>1.0</radius>
            </sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>1.0</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.8 0.9 1.0 0.4</ambient>
            <diffuse>0.9 0.95 1.0 0.4</diffuse>
            <specular>1.0 1.0 1.0 0.4</specular>
            <emissive>0.0 0.0 0.0 1.0</emissive>
            <pbr>
              <metal>
                <metalness>0.0</metalness>
                <roughness>0.02</roughness>
              </metal>
            </pbr>
          </material>
          <transparency>0.6</transparency>
        </visual>
      </link>
    </model>

    <!-- Emissive Capsule -->
    <model name="emissive_capsule">
      <pose>0 3.5 1.5 0 1.5708 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <capsule>
              <radius>0.6</radius>
              <length>2.0</length>
            </capsule>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <capsule>
              <radius>0.6</radius>
              <length>2.0</length>
            </capsule>
          </geometry>
          <material>
            <ambient>0.4 0.2 0.8 1.0</ambient>
            <diffuse>0.5 0.3 0.9 1.0</diffuse>
            <specular>0.2 0.2 0.2 1.0</specular>
            <emissive>0.3 0.15 0.6 1.0</emissive>
            <pbr>
              <metal>
                <metalness>0.0</metalness>
                <roughness>0.8</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Background Elements -->

    <!-- Back Wall for Depth Perception -->
    <model name="back_wall">
      <pose>0 -8 3 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>18 0.3 8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>18 0.3 8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.9 1.0</ambient>
            <diffuse>0.9 0.9 0.95 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
            <emissive>0.0 0.0 0.0 1.0</emissive>
            <pbr>
              <metal>
                <metalness>0.0</metalness>
                <roughness>0.9</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Side Walls -->
    <model name="left_wall">
      <pose>-9 0 3 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.3 16 8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.3 16 8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.85 0.85 1.0</ambient>
            <diffuse>0.85 0.9 0.9 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
            <emissive>0.0 0.0 0.0 1.0</emissive>
            <pbr>
              <metal>
                <metalness>0.0</metalness>
                <roughness>0.8</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <model name="right_wall">
      <pose>9 0 3 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.3 16 8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.3 16 8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.85 0.85 1.0</ambient>
            <diffuse>0.85 0.9 0.9 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
            <emissive>0.0 0.0 0.0 1.0</emissive>
            <pbr>
              <metal>
                <metalness>0.0</metalness>
                <roughness>0.8</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
