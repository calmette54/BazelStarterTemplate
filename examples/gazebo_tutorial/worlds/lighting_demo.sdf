<?xml version="1.0" ?>
<!--
  Gazebo Tutorial - Lighting Demo World
  
  This world demonstrates various lighting techniques in Gazebo:
  
  1. Light Types:
     - Directional lights (sun-like)
     - Point lights (bulb-like)  
     - Spot lights (flashlight-like)
  
  2. Lighting Properties:
     - Color (diffuse, specular, ambient)
     - Shadows and shadow quality
     - Attenuation and falloff
     - Light direction and positioning
  
  3. Advanced Lighting:
     - Multiple light sources
     - Dynamic lighting effects
     - Environmental lighting
     - Shadow mapping techniques
  
  4. Usage:
     Ideal for understanding how lighting affects visual realism
     and performance in Gazebo simulations.
-->

<sdf version="1.10">
  <world name="lighting_demo">
    
    <!-- Physics with higher update rate for smooth lighting -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Essential system plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />

    <!-- 
      Primary Directional Light (Sun)
      Simulates sunlight with parallel rays and strong shadows
    -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>1.0 0.95 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.3 -1.0</direction>
    </light>

    <!-- 
      Point Light - Red
      Demonstrates point light with red tint and sphere of influence
    -->
    <light type="point" name="point_light_red">
      <cast_shadows>true</cast_shadows>
      <pose>3 3 2 0 0 0</pose>
      <diffuse>1.0 0.2 0.2 1</diffuse>
      <specular>0.5 0.1 0.1 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.1</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- 
      Point Light - Blue
      Demonstrates cool blue lighting for contrast
    -->
    <light type="point" name="point_light_blue">
      <cast_shadows>true</cast_shadows>
      <pose>-3 3 2 0 0 0</pose>
      <diffuse>0.2 0.2 1.0 1</diffuse>
      <specular>0.1 0.1 0.5 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.1</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- 
      Point Light - Green
      Demonstrates warm green accent lighting
    -->
    <light type="point" name="point_light_green">
      <cast_shadows>false</cast_shadows> <!-- No shadows for performance -->
      <pose>0 -4 3 0 0 0</pose>
      <diffuse>0.2 1.0 0.2 1</diffuse>
      <specular>0.1 0.5 0.1 1</specular>
      <attenuation>
        <range>8</range>
        <constant>0.2</constant>
        <linear>0.1</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
    </light>

    <!-- 
      Spot Light - Focused Beam
      Demonstrates focused spot lighting with cone angle
    -->
    <light type="spot" name="spot_light">
      <cast_shadows>true</cast_shadows>
      <pose>0 5 4 0 0.7 -1.57</pose> <!-- Angled downward -->
      <diffuse>1.0 1.0 0.8 1</diffuse>
      <specular>0.8 0.8 0.6 1</specular>
      <attenuation>
        <range>15</range>
        <constant>0.1</constant>
        <linear>0.02</linear>
        <quadratic>0.005</quadratic>
      </attenuation>
      <direction>0 -1 -1</direction>
      <spot>
        <inner_angle>0.3</inner_angle> <!-- 17 degrees inner cone -->
        <outer_angle>0.8</outer_angle> <!-- 46 degrees outer cone -->
        <falloff>1.0</falloff> <!-- Smooth falloff -->
      </spot>
    </light>

    <!-- Ground plane with reflective material -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
            <!-- Reflective surface properties -->
            <pbr>
              <metal>
                <metalness>0.1</metalness>
                <roughness>0.3</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Central demonstration sphere with high reflectivity -->
    <model name="reflective_sphere">
      <pose>0 0 1 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.4</ixx>
            <iyy>0.4</iyy>
            <izz>0.4</izz>
          </inertia>
        </inertial>
        
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>1.0</radius>
            </sphere>
          </geometry>
        </collision>
        
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>1.0</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <specular>1.0 1.0 1.0 1</specular>
            <!-- Highly reflective metallic material -->
            <pbr>
              <metal>
                <metalness>0.9</metalness>
                <roughness>0.1</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Colored cubes to demonstrate different material responses -->
    <model name="red_cube">
      <pose>4 0 0.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.166</ixx>
            <iyy>0.166</iyy>
            <izz>0.166</izz>
          </inertia>
        </inertial>
        
        <collision name="collision">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
        </collision>
        
        <visual name="visual">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.1 0.1 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
            <specular>0.5 0.1 0.1 1</specular>
            <pbr>
              <metal>
                <metalness>0.2</metalness>
                <roughness>0.4</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <model name="blue_cube">
      <pose>-4 0 0.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.166</ixx>
            <iyy>0.166</iyy>
            <izz>0.166</izz>
          </inertia>
        </inertial>
        
        <collision name="collision">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
        </collision>
        
        <visual name="visual">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.3 1</ambient>
            <diffuse>0.2 0.2 0.8 1</diffuse>
            <specular>0.1 0.1 0.5 1</specular>
            <pbr>
              <metal>
                <metalness>0.1</metalness>
                <roughness>0.6</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Matte white cylinder for diffuse lighting demonstration -->
    <model name="matte_cylinder">
      <pose>0 3 0.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.25</ixx>
            <iyy>0.25</iyy>
            <izz>0.125</izz>
          </inertia>
        </inertial>
        
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.5</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
        </collision>
        
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.5</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <!-- Matte surface with minimal reflectivity -->
            <pbr>
              <metal>
                <metalness>0.0</metalness>
                <roughness>0.9</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Wall to demonstrate shadow casting -->
    <model name="shadow_wall">
      <pose>0 -6 1.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>8 0.2 3</size>
            </box>
          </geometry>
        </collision>
        
        <visual name="visual">
          <geometry>
            <box>
              <size>8 0.2 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Enhanced GUI for lighting demonstration -->
    <gui fullscreen="0">
      
      <!-- 3D Scene with enhanced rendering settings -->
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>Lighting Demo - 3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        
        <engine>ogre2</engine>
        <scene>scene</scene>
        <!-- Lower ambient light to see direct lighting effects better -->
        <ambient_light>0.2 0.2 0.2</ambient_light>
        <background_color>0.1 0.1 0.2</background_color>
        <camera_pose>-8 8 8 0 0.5 -0.785</camera_pose>
        <camera_clip>
          <near>0.1</near>
          <far>100</far>
        </camera_clip>
        <!-- Enable shadows and advanced lighting -->
        <shadows>true</shadows>
        <sky>true</sky>
      </plugin>

      <!-- World Control -->
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World Control</title>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">121</property>
          <property key="height" type="double">182</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>true</start_paused>
      </plugin>

      <!-- Entity tree -->
      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui>
          <property key="state" type="string">docked</property>
        </gz-gui>
      </plugin>

    </gui>

  </world>
</sdf>

<!--
  Lighting Concepts Demonstrated:

  1. Light Types:
     - Directional: Parallel rays (sun), good for outdoor scenes
     - Point: Omnidirectional (bulb), good for indoor lighting
     - Spot: Focused cone (flashlight), good for dramatic effects

  2. Light Properties:
     - Diffuse: Main color and brightness of the light
     - Specular: Reflection highlights and shine
     - Ambient: General illumination level
     - Attenuation: How light fades with distance

  3. Shadow Quality:
     - cast_shadows: Enable/disable shadow casting per light
     - Performance impact: More lights with shadows = slower rendering
     - Shadow resolution and quality settings

  4. Material Interaction:
     - Metalness: How metallic a surface appears (0=dielectric, 1=metal)
     - Roughness: Surface smoothness (0=mirror, 1=completely rough)
     - PBR: Physically Based Rendering for realistic materials

  5. Performance Considerations:
     - Fewer lights with shadows = better performance
     - Point lights are more expensive than directional
     - Spot lights have moderate cost with focused effect

  Learning Exercises:
  1. Toggle individual lights on/off by commenting out light elements
  2. Modify light colors and observe material interactions
  3. Adjust attenuation parameters to change light falloff
  4. Change material properties (metalness, roughness) to see effects
  5. Add more objects with different materials
  6. Experiment with spot light cone angles and direction
  7. Try different camera positions to observe lighting from various angles
-->