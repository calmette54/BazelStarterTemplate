<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="lidar_demo">

    <!-- Physics -->
    <physics name="default" type="ode">
      <max_step_size>0.033333</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- GUI Configuration for Point Cloud Visualization -->
    <gui fullscreen="0">
      <!-- 3D Scene -->
      <plugin filename="GzScene3D" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>1.0 1.0 1.0</ambient_light>
        <background_color>0.4 0.4 0.4</background_color>
        <camera_pose>-6 0 6 0 0.5 0</camera_pose>
        <sky>true</sky>
      </plugin>

      <!-- Transform Control -->
      <plugin filename="TransformControl" name="Transform control">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>

      <!-- World control -->
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <service>/world/lidar_demo</service>
      </plugin>

      <!-- World statistics -->
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <!-- 3D LiDAR Visualization Plugin -->
      <plugin filename="VisualizeLidar" name="Visualize Lidar">
        <gz-gui>
          <title>Visualize Lidar</title>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>

      <!-- Keyboard Input Plugin for movement controls -->
      <plugin filename="KeyPublisher" name="Key Publisher">
        <gz-gui>
          <title>Key Publisher</title>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>

      <!-- Topic Echo Plugin for debugging topics -->
      <plugin filename="TopicEcho" name="Topic Echo">
        <gz-gui>
          <title>Topic Echo</title>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>

      <!-- Marker Manager - Required for Point Cloud visualization -->
      <plugin filename="MarkerManager" name="Marker manager">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <world_name>lidar_demo</world_name>
      </plugin>

      <!-- Entity tree -->
      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>

      <!-- Component inspector -->
      <plugin filename="ComponentInspector" name="Component inspector">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>
    </gui>

    <!-- Lighting -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <direction>0 0 -1</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <intensity>1.0</intensity>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Test obstacles for LiDAR -->
    <model name="wall_1">
      <pose>8 0 1 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 10 2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 10 2</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_2">
      <pose>0 8 1 0 0 1.57</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 10 2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 10 2</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Various obstacle shapes -->
    <model name="cylinder_obstacle">
      <pose>-5 -5 1 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>1</radius>
              <length>2</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>1</radius>
              <length>2</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.3 0.9 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="sphere_obstacle">
      <pose>5 5 1.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <sphere><radius>1.5</radius></sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere><radius>1.5</radius></sphere>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.9 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- LiDAR platform -->
    <model name="lidar_platform">
      <pose>0 0 1 0 0 0</pose>
      <static>false</static>

      <!-- Base platform -->
      <link name="base_link">
        <!-- Disable gravity for this link -->
        <gravity>false</gravity>
        <collision name="collision">
          <geometry>
            <box><size>1 1 0.2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1 1 0.2</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- 2D LiDAR -->
      <link name="lidar_2d_link">
        <!-- Disable gravity for this link -->
        <gravity>false</gravity>
        <pose>0.3 0 0.4 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.1</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <sensor name="lidar_2d" type="gpu_lidar">
          <lidar>
            <scan>
              <horizontal>
                <samples>540</samples>
                <resolution>1</resolution>
                <min_angle>-2.356</min_angle>
                <max_angle>2.356</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.1</min>
              <max>25</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </lidar>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>true</visualize>
        </sensor>
      </link>

      <!-- 3D LiDAR -->
      <link name="lidar_3d_link">
        <!-- Disable gravity for this link -->
        <gravity>false</gravity>
        <pose>-0.3 0 0.5 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.15</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0.2 0.2 1 1</diffuse>
          </material>
        </visual>
        <sensor name="lidar_3d" type="gpu_lidar">
          <topic>/world/lidar_demo/model/lidar_platform/link/lidar_3d_link/sensor/lidar_3d/scan</topic>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
              <vertical>
                <samples>32</samples>
                <resolution>1</resolution>
                <min_angle>-0.5236</min_angle>
                <max_angle>0.5236</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.1</min>
              <max>50</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
          <always_on>1</always_on>
          <update_rate>5</update_rate>
          <visualize>true</visualize>
        </sensor>
      </link>

      <!-- Multi-beam LiDAR -->
      <link name="multibeam_link">
        <!-- Disable gravity for this link -->
        <gravity>false</gravity>
        <pose>0 0.3 0.3 0 0 1.57</pose>
        <visual name="visual">
          <geometry>
            <box><size>0.1 0.06 0.04</size></box>
          </geometry>
          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0.2 1 0.2 1</diffuse>
          </material>
        </visual>
        <sensor name="multibeam" type="gpu_lidar">
          <lidar>
            <scan>
              <horizontal>
                <samples>180</samples>
                <resolution>1</resolution>
                <min_angle>-1.57</min_angle>
                <max_angle>1.57</max_angle>
              </horizontal>
              <vertical>
                <samples>4</samples>
                <resolution>1</resolution>
                <min_angle>-0.1</min_angle>
                <max_angle>0.1</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.1</min>
              <max>15</max>
              <resolution>0.005</resolution>
            </range>
          </lidar>
          <always_on>true</always_on>
          <update_rate>20</update_rate>
          <visualize>true</visualize>
        </sensor>
      </link>

      <!-- Joints -->
      <joint name="lidar_2d_joint" type="fixed">
        <parent>base_link</parent>
        <child>lidar_2d_link</child>
      </joint>

      <joint name="lidar_3d_joint" type="fixed">
        <parent>base_link</parent>
        <child>lidar_3d_link</child>
      </joint>

      <joint name="multibeam_joint" type="fixed">
        <parent>base_link</parent>
        <child>multibeam_link</child>
      </joint>
    </model>

  </world>
</sdf>
