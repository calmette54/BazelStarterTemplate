<?xml version="1.0" ?>
<!--
  Gazebo Tutorial - Simple Basic World (No Dynamic Plugins)
  
  This is a simplified version that works with statically linked plugins
  and demonstrates the core Gazebo functionality without runtime plugin loading.
-->
<sdf version="1.10">
    <world name="basic_world_simple">
        <!-- Physics Configuration -->
        <physics name="1ms" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
            <real_time_update_rate>1000</real_time_update_rate>
        </physics>
        
        <!-- Lighting Setup -->
        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>
        
        <!-- Ground Plane Model -->
        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <!-- Collision geometry for physics -->
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                        </plane>
                    </geometry>
                </collision>
                <!-- Visual representation -->
                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.8 0.8 0.8 1</ambient>
                        <diffuse>0.8 0.8 0.8 1</diffuse>
                        <specular>0.8 0.8 0.8 1</specular>
                    </material>
                </visual>
            </link>
        </model>
        
        <!-- Simple Box Model -->
        <model name="simple_box">
            <pose>0 0 0.5 0 0 0</pose>
            <link name="link">
                <inertial>
                    <mass>1.0</mass>
                    <inertia>
                        <ixx>0.166</ixx>
                        <iyy>0.166</iyy>
                        <izz>0.166</izz>
                    </inertia>
                </inertial>
                <!-- Collision geometry -->
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>1 1 1</size>
                        </box>
                    </geometry>
                </collision>
                <!-- Visual geometry -->
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>1 1 1</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.2 0.5 0.8 1</ambient>
                        <diffuse>0.2 0.5 0.8 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material>
                </visual>
            </link>
        </model>
    </world>
</sdf>