# Go bindings (cgo) for the Eigen-based C++ library in examples/eigen_math.
#
# A separate Bazel module: build it from this directory, not from the
# repository root (the root .bazelignore skips examples/).
module(name = "example_eigen_go")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "rules_go", version = "0.65.0")
# go_deps (go.mod) comes from gazelle
bazel_dep(name = "gazelle", version = "0.54.0")

# The C++ library, shared with examples/eigen_pybind
bazel_dep(name = "example_eigen_math")
local_path_override(
    module_name = "example_eigen_math",
    path = "../eigen_math",
)

# Same hermetic LLVM toolchain as the template (symlink to
# ../../bzl/toolchains.MODULE.bazel); cgo compiles with it.
include("//:toolchains.MODULE.bazel")

#--------------------- Go Toolchain --------------
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.3")

# Third-party Go modules come from go.mod / go.sum
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_stretchr_testify")
