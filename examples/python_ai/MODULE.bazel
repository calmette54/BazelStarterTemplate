# A Python package (PyTorch + Pydantic) whose BUILD files are generated by
# Gazelle.
#
# A separate Bazel module: build it from this directory, not from the
# repository root (the root .bazelignore skips examples/).
module(name = "example_python_ai")

bazel_dep(name = "rules_python", version = "2.4.5")

# Gazelle with the Python plugin generates the BUILD files
bazel_dep(name = "rules_python_gazelle_plugin", version = "2.4.5")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "rules_go", version = "0.65.0")

# Same hermetic LLVM toolchain as the template (symlink to
# ../../bzl/toolchains.MODULE.bazel); the Gazelle plugin uses cgo.
include("//:toolchains.MODULE.bazel")

#--------------------- Python Toolchain --------------
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    # CPU-only PyTorch wheels (much smaller than the CUDA ones)
    extra_pip_args = [
        "--index-url=https://download.pytorch.org/whl/cpu",
        "--extra-index-url=https://pypi.org/simple",
    ],
    hub_name = "pypi",
    python_version = "3.12",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "pypi")
