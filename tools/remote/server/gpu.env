# gpu-scaler's settings, sourced from /opt/rbe-remote/gpu.env (setup.sh).
#
# The vast.ai offers: one GPU of the development build's architecture (sm_86,
# --@rules_cuda//cuda:archs in .bazelrc; an Ada box would JIT the kernels from
# PTX on every fresh box) with 24 GB or more, which serves requires-gpu and
# requires-large-gpu alike; a fast downlink for the inputs from the server; a
# direct ssh port. A fresh box pulls the test's inputs from the server: when
# the downlink varies a lot with the distance, keep the boxes near the server,
# e.g. `geolocation in [DE,FR,NL]` (ISO country codes).
QUERY="gpu_name in [RTX_3090,RTX_A5000,RTX_A6000,A40] num_gpus=1 cpu_ram>=32 disk_space>=100 cuda_vers>=12.8 reliability>0.98 inet_down>=500 direct_port_count>=1 verified=true rentable=true"
# $/hour at most: the cheapest offer below it is rented.
MAX_DPH=0.50
# GB: the worker's input cache (60 GB, ../worker/nativelink.json5) and the actions.
DISK=100
# Destroy the box this long after its last GPU action.
IDLE_MINUTES=10
# The box destroys itself after this long in any case.
MAX_HOURS=8
# $ of rentals a month (the ledger in /var/lib/rbe-remote): none beyond.
MONTHLY_CAP=60
# Seconds for a box to come up, and for its worker to register.
LAUNCH_TIMEOUT=600
POLL_SECONDS=10
