"""
Open3D Example - Pure Application Layer

This BUILD file demonstrates the simplest possible application usage after 
clean separation of concerns:
- MODULE.bazel: Raw nixpkgs package imports only
- open3d.BUILD: All integration logic (headers, SONAME, cc_import, linkopts)
- BUILD.bazel: Minimal application depending on single @open3d//:open3d target

The Open3D target now contains ALL system dependencies, headers, and linkopts
embedded within it, so applications just need a single dependency.
"""

package(default_visibility = ["//visibility:public"])

# Simple Open3D application - single dependency only
cc_binary(
    name = "open3d_example",
    srcs = ["simple_open3d.cpp"],
    # No linkopts needed - embedded in Open3D target
    # No env variables needed for basic functionality
    tags = [
        "hermetic_integration",
        "open3d_example",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@open3d",  # Single dependency - includes ALL system libs and headers
    ],
)

# Headless version for CI/CD environments
cc_binary(
    name = "open3d_example_headless",
    srcs = ["simple_open3d.cpp"],
    env = {
        "OPEN3D_HEADLESS": "1",  # Force headless mode
    },
    tags = [
        "headless",
        "hermetic_integration",
        "open3d_example",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@open3d",  # Single dependency
    ],
)
